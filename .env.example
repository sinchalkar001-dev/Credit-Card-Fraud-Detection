# Copy to .env and adjust. main.py reads it on start; real environment
# variables take precedence.

# development or production
FLASK_ENV=development
# True turns on the reloader and the in-browser debugger (local use only)
FLASK_DEBUG=False

# Sign session cookies. Use a long random value outside local development:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The single analyst login. The sign-in page shows these only while they are the defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Where the local server listens
HOST=127.0.0.1
PORT=5000

# Only send the session cookie over HTTPS (production default: True)
SESSION_COOKIE_SECURE=False
